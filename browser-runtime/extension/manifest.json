{
	"manifest_version": 3,
	"name": "Laplace Browser Connection",
	"version": "0.4.2",
	"description": "Connect signed-in accounts from your AI agent. Review access in chat.",
	"key": "",
	"permissions": ["activeTab", "scripting", "storage", "alarms", "nativeMessaging"],
	"host_permissions": [
		"http://127.0.0.1/*",
		"https://*.slack.com/*",
		"https://*.slack-gov.com/*",
		"https://apply.ycombinator.com/*"
	],
	"background": {
		"service_worker": "worker.js",
		"type": "module"
	},
	"action": {
		"default_popup": "panel.html"
	},
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'none'"
	}
}
